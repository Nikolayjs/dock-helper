{
  // Ужесточение для кода, который считает и разбирает: движки формул, чтение и запись Word и Excel,
  // разбор чужого реестра пациентов и лабораторных файлов.
  //
  // `noUncheckedIndexedAccess` включён **здесь, а не для всего приложения**, и это замер, а не
  // компромисс: на всём `src` он даёт 196 ошибок, из которых 137 — обращение к массиву, только что
  // созданному строкой выше. Заглушить их можно только россыпью `!`, то есть утверждением ровно
  // того, о чём предупреждает флаг. Пользы в этом нет, а шума в коде — много.
  //
  // Здесь же выход за границу массива значит не «лишний рендер», а неверное число в справке: ячейка
  // не из той строки, полоса не того возраста, аргумент не той функции. Эти пятьдесят девять мест
  // разобраны поимённо.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.strict.tsbuildinfo",
    "noUncheckedIndexedAccess": true
  },
  // Тесты сюда не входят: `result[0].value` в проверке — это утверждение, которое проверка и делает,
  // и городить вокруг него guard значило бы проверять тест вместо кода.
  "exclude": ["**/*.test.ts", "**/*.test.tsx"],
  "include": [
    "src/lib/**/*.ts",
    "src/features/analyzer/**/*.ts",
    "src/features/patients/import/**/*.ts",
    "src/features/patients/import/**/*.tsx"
  ]
}
